# Example only; never commit real credentials. Not automatically loaded by start:v3.
NODE_ENV=production
V3_RELEASE_DIR=/srv/hireflow-v3/releases/APPROVED_SHA
V3_DATA_ROOT=/var/lib/hireflow-v3
V3_DATABASE_PATH=/var/lib/hireflow-v3/fresh.db
V3_PORT=3301
V3_SHUTDOWN_MS=10000
V3_CLIENT_ORIGINS=https://hireflow-wed.onrender.com
V3_JWT_SECRET=REPLACE_WITH_APPROVED_SECRET
# No V3_STATIC_DIR needed for Render hosting.
# Render build environment ONLY (not a secret):
# VITE_HIREFLOW_V3_API_URL=https://api.pixelweave.xyz/api/v3

# Must equal approved actual release Git SHA; checkout must be clean.
V3_EXPECTED_SHA=REPLACE_WITH_APPROVED_40_HEX_SHA
